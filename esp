-- =========================================
-- ENCONTRAR ALVO
-- =========================================

local function encontrarAlvo()
    local melhorAlvo = nil
    local menorDistancia = raio

    local centro = Vector2.new(
        camera.ViewportSize.X / 2,
        camera.ViewportSize.Y / 2
    )

    for _, outro in ipairs(Players:GetPlayers()) do
        if outro ~= player and outro.Character then

            local cabeca = outro.Character:FindFirstChild("Head")
            local humanoid = outro.Character:FindFirstChildOfClass("Humanoid")

            if cabeca and humanoid and humanoid.Health > 0 then

                local posicao, visivel =
                    camera:WorldToViewportPoint(cabeca.Position)

                if visivel then

                    local distancia = (
                        Vector2.new(posicao.X, posicao.Y) - centro
                    ).Magnitude

                    if distancia < menorDistancia then
                        menorDistancia = distancia
                        melhorAlvo = cabeca
                    end
                end
            end
        end
    end

    return melhorAlvo
end

-- =========================================
-- AIM ASSIST
-- =========================================

RunService.RenderStepped:Connect(function(dt)

    if not miraAtiva then
        return
    end

    tempoSemMovimento += dt

    if not alvoAtual and tempoSemMovimento > 0.15 then
        alvoAtual = encontrarAlvo()
    end

    if alvoAtual and alvoAtual.Parent then

        local destino = CFrame.lookAt(
            camera.CFrame.Position,
            alvoAtual.Position
        )

        camera.CFrame = camera.CFrame:Lerp(
            destino,
            suavidade
        )

    else
        alvoAtual = nil
    end
end)
