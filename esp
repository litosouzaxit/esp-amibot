-- =========================================
-- ESP
-- =========================================

local function criarESP(outro)
    if outro == player then
        return
    end

    local character = outro.Character
    if not character then
        return
    end

    if character:FindFirstChild("ESP_Highlight") then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = character
end

local function removerESP(outro)
    if outro.Character then
        local highlight = outro.Character:FindFirstChild("ESP_Highlight")

        if highlight then
            highlight:Destroy()
        end
    end
end

local function atualizarESP()
    for _, outro in ipairs(Players:GetPlayers()) do
        if outro ~= player then
            if espAtivo then
                criarESP(outro)
            else
                removerESP(outro)
            end
        end
    end
end

espBotao.MouseButton1Click:Connect(function()
    espAtivo = not espAtivo

    if espAtivo then
        espBotao.Text = "Ativar ESP: LIGADO"
        atualizarESP()
    else
        espBotao.Text = "Ativar ESP: DESLIGADO"
        atualizarESP()
    end
end)

Players.PlayerAdded:Connect(function(outro)
    outro.CharacterAdded:Connect(function()
        task.wait(1)

        if espAtivo then
            criarESP(outro)
        end
    end)
end)

